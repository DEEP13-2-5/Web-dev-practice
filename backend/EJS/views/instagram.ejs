<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram</title>
    <style>
        img{
            height: 100px;
            width:100px;
        }
    </style>
</head>
<body>
    <h2>this page belong to <%= data.name %> </h2>
    <button>followers</button>
    <button>message</button>
    <br>
    <br>
    <p1> followers <%= data.followers %></p1> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
    <p2> following <%= data.following %></p2>    
    <hr>

    <% for(let post of data.posts){ %>
        <img src="<%= post.image %>" alt="some img"/><br>
        <p1> likes <%= post.likes %></p1> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<br>
        <p2> comments <%= post.comments %></p2> <br>
    <% }  %>
</body>
</html>